PORT=4173
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Optional local-only Excel import.
# In cloud hosting, publish data/db.json instead of relying on this Windows path.
CASA_PIA_SOURCE_DIR=C:/Users/catas/OneDrive - Universidade do Algarve/Ambiente de Trabalho/CASA PIA AC
CASA_PIA_XLSX=C:/Users/catas/OneDrive - Universidade do Algarve/Ambiente de Trabalho/CASA PIA AC/Casa pia.xlsx

# Optional cloud sync. Use a direct download link to Casa pia.xlsx.
# If set, Catarina can click "Sincronizar link online".
# If CASA_PIA_AUTO_SYNC_MINUTES is greater than 0, the server syncs on a timer.
CASA_PIA_XLSX_URL=https://docs.google.com/spreadsheets/d/1nQnhwHzXcjsOqRvEyl19ipSWQfxIaJ5O/export?format=xlsx
CASA_PIA_AUTO_SYNC_MINUTES=5

# Optional ZeroZero integration.
# 0 = manual only. Example: 360 = sync every 6 hours.
ZEROZERO_AUTO_SYNC_MINUTES=0
ZEROZERO_AUTO_SYNC_SEASON=2024/2025
ZEROZERO_AUTO_SYNC_UNTIL_CURRENT=1
